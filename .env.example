# Optional. Without these the app runs in local mode (projects saved in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Map and address lookup default to OpenStreetMap's free public services, which are meant for
# light use. For heavier use, point these at your own or a paid provider (Nominatim-compatible geocoder,
# and an XYZ tile URL such as https://tiles.example.com/{z}/{x}/{y}.png) and set the attribution they require.
NEXT_PUBLIC_GEOCODER_URL=
NEXT_PUBLIC_TILE_URL=
NEXT_PUBLIC_TILE_ATTRIBUTION=

# Membership (Free / Plus / Pro / Studio). OFF by default: with billing off every feature is unlocked and
# nothing is limited. To turn it on, run supabase/billing.sql after supabase/schema.sql, create the Stripe
# products and prices, fill everything below, then set NEXT_PUBLIC_BILLING_ENABLED=true.
NEXT_PUBLIC_BILLING_ENABLED=
NEXT_PUBLIC_SITE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One recurring Stripe price per plan and interval (plus/pro/studio x weekly/monthly/yearly).
STRIPE_PRICE_PLUS_WEEKLY=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO_WEEKLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_STUDIO_WEEKLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=
# Optional: STRIPE_AUTOMATIC_TAX=1, STRIPE_REQUIRE_TERMS=1
# Staging/demo ONLY, never production: lets anyone pick a plan on /pricing without paying.
NEXT_PUBLIC_BILLING_PREVIEW=

# Daily market updates (a Plus-and-up feature when billing is on). Run supabase/market.sql, then have a scheduler call
# GET /api/cron/market once a day with "Authorization: Bearer <CRON_SECRET>" (the included GitHub Action does this).
# Uses SUPABASE_SERVICE_ROLE_KEY from above. MARKET_BIS_URL is only needed if the BIS changes its API address.
CRON_SECRET=
MARKET_BIS_URL=

# Shown on the Privacy and Support pages (required before publishing to an app store).
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
